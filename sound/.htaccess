#php_value error_reporting 0
#php_flag display_errors On

# Turn on URL rewriting
RewriteEngine On

# enable symbolic links
Options +FollowSymLinks

#RewriteCond %{SERVER_PORT} 80
#RewriteRule ^(.*)$ https://naufragio.net/$1 [R,L]

# Protect application and system files from being viewed
RewriteRule ^(application|modules|system) - [F,L]

RewriteRule \.(css|jpe?g|gif|png|js|ico)$ - [L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f

# Secciones principales
RewriteRule ^([a-zA-Z]+)$          					index.php?section=$1 [L]
RewriteRule ^([a-zA-Z]+)/$          				index.php?section=$1 [L]

# Diferentes tipos de contenido
RewriteRule ^([a-zA-Z]+)/([a-zA-Z]+?)$       		index.php?section=$1&type=$2 [QSA,L]
RewriteRule ^([a-zA-Z]+)/([a-zA-Z]+?)/$       		index.php?section=$1&type=$2 [QSA,L]

# Páginas de secciones - Clase, raza, poder, etc
RewriteRule ^([a-zA-Z]+)/([a-zA-Z0-9_-]+)$          index.php?section=$1&page=$2 [L]
RewriteRule ^([a-zA-Z]+)/([a-zA-Z0-9_-]+)/$         index.php?section=$1&page=$2 [L]

# Páginas con subtipos
RewriteRule ^([a-zA-Z]+)/([a-zA-Z]+)/([a-zA-Z]+)$   index.php?section=$1&type=$2&subtype=$3 [L]
RewriteRule ^([a-zA-Z]+)/([a-zA-Z]+)/([a-zA-Z]+)/$  index.php?section=$1&type=$2&subtype=$3 [L]